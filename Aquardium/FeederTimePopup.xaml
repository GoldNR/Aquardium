<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="Aquardium.FeederTimePopup"
    x:TypeArguments="x:String"
    WidthRequest="300"
    Padding="20"
    BackgroundColor="#2C2C2E">

    <VerticalStackLayout Spacing="15">

        <Label 
            Text="Set Feeding Schedule" 
            FontSize="20" 
            TextColor="White"
            HorizontalOptions="Center" />

        <!-- ComboBox (Picker) for number of feedings -->
        <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
            <Label Text="Feedings per day:" 
                   TextColor="White"
                   VerticalOptions="Center" />
            <Picker x:Name="FeedCountPicker" 
                    WidthRequest="100"
                    SelectedIndexChanged="OnFeedCountChanged">
                <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>1</x:String>
                        <x:String>2</x:String>
                        <x:String>3</x:String>
                    </x:Array>
                </Picker.ItemsSource>
            </Picker>
        </HorizontalStackLayout>

        <!-- Container for dynamically showing time inputs -->
        <VerticalStackLayout x:Name="TimeInputsContainer" Spacing="10">
            <!-- Default: one set of time entries -->
            <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                <Entry x:Name="HourEntry1" Placeholder="HH" Keyboard="Numeric" WidthRequest="60"/>
                <Entry x:Name="MinuteEntry1" Placeholder="MM" Keyboard="Numeric" WidthRequest="60"/>
                <Picker x:Name="PeriodPicker1" WidthRequest="60">
                    <Picker.ItemsSource>
                        <x:Array Type="{x:Type x:String}">
                            <x:String>AM</x:String>
                            <x:String>PM</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- Buttons -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <BoxView Grid.Column="0" BackgroundColor="Transparent"/>

            <Button 
                Text="Cancel"
                TextColor="White"
                Clicked="OnCancelClicked"
                Grid.Column="1"
                BackgroundColor="Transparent"
                BorderColor="Transparent"
                Padding="10,5"/>

            <Button 
                Text="Save"
                TextColor="White"
                Clicked="OnSaveClicked"
                Grid.Column="2"
                BackgroundColor="Transparent"
                BorderColor="Transparent"
                Padding="10,5"/>
        </Grid>

    </VerticalStackLayout>
</toolkit:Popup>
